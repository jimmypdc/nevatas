# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Auth (NextAuth v5) ---
AUTH_SECRET=change-me-to-a-32-byte-random-string
AUTH_TRUST_HOST=true
# Sliding session lifetime. Active users get JWTs re-minted every
# SESSION_UPDATE_AGE_MINUTES; absolute hard expiry is SESSION_MAX_AGE_HOURS.
# Browser-side idle watcher signs the user out after
# SESSION_IDLE_TIMEOUT_MINUTES with a SESSION_IDLE_WARNING_SECONDS countdown.
SESSION_MAX_AGE_HOURS=8
SESSION_UPDATE_AGE_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_IDLE_WARNING_SECONDS=30

# --- Database (Postgres) ---
# Local dev: docker run --name nevatas-pg -e POSTGRES_PASSWORD=nevatas -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/nevatas?schema=public

# --- Field-level encryption ---
# KMS_DRIVER selects how data encryption keys (DEKs) are wrapped:
#   env  — wraps with FIELD_ENCRYPTION_KEY directly. Dev/test only.
#   aws  — wraps via AWS KMS (see lib/kms/aws.ts wiring checklist before flipping).
KMS_DRIVER=env
# 32 bytes, base64-encoded. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required even with KMS_DRIVER=aws (legacy v1 ciphertext fallback during migration).
FIELD_ENCRYPTION_KEY=replace-me-with-32-byte-base64-key
# Required when KMS_DRIVER=aws. Must be a key ARN (not an alias).
AWS_KMS_KEY_ID=

# --- Secrets manager ---
# SECRETS_DRIVER selects where sensitive values come from at runtime:
#   env  — process.env (dev/test). The vars in this file are authoritative.
#   aws  — AWS Secrets Manager via lib/secrets/aws.ts. Run the wiring checklist
#          before flipping. Plaintext values in .env become documentation only.
SECRETS_DRIVER=env
# Required when SECRETS_DRIVER=aws. Per-environment prefix for stored secrets,
# e.g. /nevatas/prod (no trailing slash). Each name in lib/secrets/driver.ts
# SECRET_NAMES is fetched as <prefix>/<NAME>.
AWS_SECRETS_PREFIX=

# --- Object storage ---
# Driver: "local" for dev, "s3" or "r2" for production
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Email ---
# console — log to stdout (dev); resend / aws_ses for production.
EMAIL_DRIVER=console
# Required for any non-console driver. Format: "Name <addr@domain>".
EMAIL_FROM=Nevatas <noreply@nevatas.local>
RESEND_API_KEY=

# --- Payroll integrations ---
# PAYCOR_DRIVER selects which Paycor adapter is used:
#   mock — returns deterministic test data (no Paycor account required); dev default.
#   live — calls the real Paycor API. Requires the credentials below.
# See lib/integrations/paycor/live-adapter.ts for the production wiring checklist.
PAYCOR_DRIVER=mock
PAYCOR_CLIENT_ID=
PAYCOR_CLIENT_SECRET=
PAYCOR_API_BASE_URL=
PAYCOR_AUTH_BASE_URL=

# --- Backup verification (SOC 2 A1.2) ---
# Shared secret the backup pipeline POSTs with as `authorization: Bearer <secret>`
# to /api/admin/backup-verifications. When unset, the ingest endpoint refuses
# every request (default-deny). Minimum 16 characters.
BACKUP_REPORT_SECRET=
# Comma-separated identifiers your backup pipeline reports under. The
# evidence center compares observed vs expected and flags missing /
# stale (>24h old) sources.
# Example: BACKUP_EXPECTED_SOURCES=primary-db,object-storage,audit-archive
BACKUP_EXPECTED_SOURCES=
